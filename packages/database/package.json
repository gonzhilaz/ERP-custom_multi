{
  "name": "@erp/database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate:master": "npx prisma generate --schema=prisma/master.prisma",
    "db:generate:tenant": "npx prisma generate --schema=prisma/tenant.prisma",
    "db:generate": "npm run db:generate:master && npm run db:generate:tenant",
    "seed:master": "npx tsx src/seed.ts",
    "seed:tenant": "npx tsx src/tenant-seed.ts",
    "seed": "npm run seed:master && npm run seed:tenant",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "^5.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
