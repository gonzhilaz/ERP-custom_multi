# Environment Variables Example for ERP Multi-Tenant Enterprise

# Master Holding PostgreSQL Connection
MASTER_DATABASE_URL="postgresql://master_admin:master_password_2026@localhost:5432/db_master_holding?schema=public"

# Default Tenant Database Connection Template
TENANT_DATABASE_URL="postgresql://tenant_admin:tenant_password_2026@localhost:5432/db_tenant_default?schema=public"

# Express API Config
PORT=5000
JWT_SECRET="erp-super-secret-jwt-key-2026-production"

# OpenClaw & DeepSeek Lite AI Integration
DEEPSEEK_API_KEY="sk-deepseek-lite-demo-key"
OPENCLAW_WHATSAPP_WEBHOOK_SECRET="claw-wa-secret-2026"

# Next.js Web Frontend Config
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
