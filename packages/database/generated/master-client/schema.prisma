datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/master-client"
}

enum IndustryType {
  RETAIL
  PRODUCTION_MANUFACTURING
  HOTEL_HOSPITALITY
  RESTAURANT_CATERING
  VENDOR_SUPPLIER
  GOLD_MINING
  OTHER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  MAINTENANCE
}

enum UserSystemRole {
  SUPER_ADMIN
  HOLDING_EXECUTIVE
  TENANT_USER
}

model Tenant {
  id              String       @id @default(uuid())
  code            String       @unique // e.g. "RESTO-01", "MINE-GOLD-01"
  name            String
  industryType    IndustryType
  dbConnectionUri String // Encrypted connection string for tenant database
  status          TenantStatus @default(ACTIVE)
  modulesEnabled  String[] // Array of enabled module IDs e.g. ["FINANCE", "INVENTORY", "HRD", "POS"]
  logoUrl         String?
  address         String?
  phone           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userAccesses     UserTenantAccess[]
  consolidatedLogs HoldingConsolidatedLedger[]

  @@map("tenants")
}

model MasterUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  systemRole   UserSystemRole @default(TENANT_USER)
  isActive     Boolean        @default(true)
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenantAccesses UserTenantAccess[]
  auditLogs      GlobalAuditLog[]

  @@map("master_users")
}

model UserTenantAccess {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  isDefault    Boolean  @default(false)
  roleInTenant String // e.g. "MANAGER", "FINANCE_STAFF", "DIREKSI"
  createdAt    DateTime @default(now())

  user   MasterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("user_tenant_accesses")
}

model HoldingConsolidatedLedger {
  id               String   @id @default(uuid())
  tenantId         String
  periodMonth      Int // 1 - 12
  periodYear       Int // e.g. 2026
  totalRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  totalExpense     Decimal  @default(0) @db.Decimal(18, 2)
  netProfitLoss    Decimal  @default(0) @db.Decimal(18, 2)
  totalAssets      Decimal  @default(0) @db.Decimal(18, 2)
  totalLiabilities Decimal  @default(0) @db.Decimal(18, 2)
  currency         String   @default("IDR")
  syncedAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodYear, periodMonth])
  @@map("holding_consolidated_ledgers")
}

model GlobalAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  target    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user MasterUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("global_audit_logs")
}
