{
  "region": "ap-southeast-1",
  "apps": {
    "admin": {
      "name": "admin",
      "root": "apps/admin",
      "framework": "nextjs",
      "httpPort": 3000,
      "build": {
        "command": "npm run build"
      }
    },
    "api": {
      "name": "api",
      "root": "apps/api",
      "framework": "custom",
      "httpPort": 3000,
      "build": {
        "command": "npx prisma generate --schema=../../packages/database/prisma/master.prisma && npx prisma generate --schema=../../packages/database/prisma/tenant.prisma && tsc",
        "outputDirectory": ".",
        "entrypoint": "dist/index.js"
      }
    },
    "web": {
      "name": "web",
      "root": "apps/web",
      "framework": "nextjs",
      "httpPort": 3000,
      "build": {
        "command": "npm run build"
      }
    }
  }
}
